# `engines.node` in package.json (>=22.13.0) is a requirement, not a hint:
# jsdom 29 needs Node ^22.13.0 within the 22.x line, and CI pins Node 22 in
# every job that runs this frontend. Without `engine-strict`, npm only warns
# on an unsupported Node and `npm ci` still succeeds -- the first failure then
# surfaces as `Cannot find native binding` deep in a transitive dependency,
# naming nothing in this project. This makes the mismatch fail at `npm ci`
# instead, with a message that names the actual requirement.
engine-strict=true
